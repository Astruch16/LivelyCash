# Canonical origin used for canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt. No trailing slash. Falls back to https://www.livelycashatms.com.
NEXT_PUBLIC_SITE_URL="https://www.livelycashatms.com"

# Contact-form email delivery, via Resend.
#
# Without RESEND_API_KEY the form logs the enquiry and succeeds in
# development, and returns a 502 with our phone number in production. Never
# leave it unset on a live deployment: that is a silently broken lead form.
RESEND_API_KEY=""

# Where enquiries land. Defaults to siteConfig.email if unset.
CONTACT_TO_EMAIL="livelycashatms@gmail.com"

# The sender. Resend only accepts an address on a domain verified in the
# account, with one exception: onboarding@resend.dev, which can ONLY deliver
# to the email address that owns the Resend account. Use that to test, then
# switch to something like "Lively Cash Website <website@livelycashatms.com>"
# once the domain is verified at resend.com/domains.
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# --- Not wired up yet ---------------------------------------------------

# Production rate-limit store (see TODO in lib/rate-limit.ts).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
